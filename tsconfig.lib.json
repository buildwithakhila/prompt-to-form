{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "declaration": true,
        "emitDeclarationOnly": false,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/index.ts",
        "src/core/**/*.ts"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
    ]
}